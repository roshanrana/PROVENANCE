.venv/
__pycache__/
*.pyc
.mypy_cache/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Secrets — NFR-14. Private keys and generated tenant credentials never enter git.
*.ed25519
!tests/fixtures/testkey.ed25519
.env
.secrets/
# Kept as well: the original home for generated tenant keys. They now live in
# .secrets/ instead, because bench/results/ is uploaded WHOLESALE as a CI
# artifact and .gitignore keeps a file out of git, not out of an artifact.
bench/results/**/tenant-keys/

# Transfer artefacts from the Cowork session — never part of the repo.
_incoming.tgz
_m*.tgz
_to_delete/

# graphify: keep the human-readable report, drop the derived graph data.
graphify-out/*
!graphify-out/GRAPH_REPORT.md
